# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# ARCHITECTURAL ROLE:
# 1. Blueprint: Defines the required environment schema and keys for this framework.
# 2. Security: Checked into Git to provide structure without exposing secrets.
#
# CODEWISE USAGE & LIFECYCLE:
# - Setup: Copy this file to create your local `.env` (e.g., `cp config/.env.example .env`).
# - Runtime: `playwright.config.ts` loads `.env` into `process.env`.
# - Validation: `config/env.config.ts` parses `process.env` into a strongly-typed config.
#
# NOTE: This file is NEVER parsed by code directly. Do NOT put real secrets here!
# ==============================================================================

# Application Under Test Target Environment (dev | qa | prod)
TEST_ENV=qa

# Base URLs
BASE_URL=https://eventhub.rahulshettyacademy.com/
API_BASE_URL=https://eventhub.rahulshettyacademy.com/api

# Authentication Credentials
ADMIN_USER=admin@eventhub.com
ADMIN_PASS=Password123!

# Global Configuration
LOG_LEVEL=info